# Copy to .env and fill in. Never commit .env.

DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL used in printed QR labels (production).
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 bike photo storage — see docs/r2-setup.md.
# Leave all blank in local dev to store photos under public/uploads instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket: custom domain or the r2.dev URL, no trailing slash.
R2_PUBLIC_URL=
